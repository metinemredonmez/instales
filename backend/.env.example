# InstiLens backend configuration.  cp .env.example .env  (git-ignored; the backend reads it on start).
# Every setting is a pydantic field in src/instilens/config.py (env prefix INSTILENS_); a commented line shows that
# field's real default, except the few marked "(example)" whose default is empty/None and whose comment says so.
# As copied, this file boots in DEVELOPMENT (SQLite, fixture-free real adapters, dev JWT secret).
# PRODUCTION refuses to start until INSTILENS_JWT_SECRET is replaced with ≥32 random characters — that check stays.

# ── core ─────────────────────────────────────────────────────────────────────────────────────────────
INSTILENS_ENVIRONMENT=development                 # production = HTTPS-only cookies, secret check, strict CORS
INSTILENS_JWT_SECRET=dev-only-change-me           # REPLACE in production:  openssl rand -hex 32
# INSTILENS_JWT_TTL_MINUTES=10080                 # session length (7 days)
# INSTILENS_DATABASE_URL=postgresql+psycopg://instilens:PASS@127.0.0.1:5432/instilens  # (example) default: SQLite file in backend/ (dev)
# POSTGRES_PASSWORD=                              # prod only: server-setup.sh creates the "instilens" role with it (same PASS as above)
# INSTILENS_PUBLIC_URL=http://localhost:5173      # base URL in notification links + release download links (prod: https://app.instilens.com)
# INSTILENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost","http://tauri.localhost"]  # prod: add https://app.instilens.com
# INSTILENS_ALLOW_REGISTRATION=true               # false = invite-only (admins create users)
# INSTILENS_DEFAULT_MARKET=TR

# ── auth hardening ───────────────────────────────────────────────────────────────────────────────────
# INSTILENS_AUTH_RATE_LIMIT_PER_MINUTE=10         # per client IP on /auth/login and /auth/register
# INSTILENS_TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]  # only these peers may set X-Forwarded-For (nginx on the same box)
# INSTILENS_ACCOUNT_LOCKOUT_ATTEMPTS=8            # failed logins per e-mail inside the window → temporary lock
# INSTILENS_ACCOUNT_LOCKOUT_MINUTES=15
# INSTILENS_BREACHED_PASSWORD_CHECK=true          # reject passwords seen in breaches (HIBP k-anonymity; false in offline CI)
# INSTILENS_AI_REQUESTS_PER_HOUR=30               # AI budget: per-user cap on /research and forced AI refreshes (paid calls)

# ── data sources ─────────────────────────────────────────────────────────────────────────────────────
# INSTILENS_KAP_ADAPTER=public                    # public = polite kap.org.tr prototype; api = licensed Veri Yayın Servisi; fixture = tests only
# INSTILENS_KAP_API_BASE_URL=https://apigwdev.mkk.com.tr/api/vyk
# INSTILENS_KAP_API_KEY=                          # MKK API Portal → My Apps (with the secret below)
# INSTILENS_KAP_API_SECRET=
# INSTILENS_KAP_API_AUTH_HEADER=                  # optional portal-issued Authorization value
# INSTILENS_KAP_API_AUTH_MODE=auto                # pin (e.g. apikey) once `instilens kap-test` reports it
# INSTILENS_KAP_API_RATE_PER_MIN=6                # Free plan throttle
# INSTILENS_KAP_API_MAX_CALLS=120                 # per run
# INSTILENS_KAP_PUBLIC_DAYS_BACK=7                # public adapter: window, detail pages and fund PDFs per run
# INSTILENS_KAP_PUBLIC_MAX_DETAILS=25
# INSTILENS_KAP_PUBLIC_MAX_REPORTS=40
# INSTILENS_KAP_PUBLIC_FUND_CODES=[]              # empty = every equity-focused fund seen in the window
# INSTILENS_KAP_FIXTURE_DIR=./fixtures/kap         # fixture adapters (tests only)
# INSTILENS_SEC_FIXTURE_DIR=./fixtures/sec
# INSTILENS_SEC_ADAPTER=edgar                     # edgar = live EDGAR (free); fixture = tests only
# INSTILENS_SEC_USER_AGENT=InstiLens research@instilens.app   # SEC requires "AppName contact@email" — put a real address here
# INSTILENS_SEC_CIKS=["1067983","1350694","1037389"]     # Berkshire, Bridgewater, Renaissance

# ── AI (Claude) ──────────────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...                    # (example) plain name (or INSTILENS_ANTHROPIC_API_KEY); unset = AI research/news tagging off
# INSTILENS_AI_PROVIDER=claude                    # local = self-hosted model (reserved)
# INSTILENS_AI_MODEL=claude-opus-5                # briefs, stock notes, research
# INSTILENS_AI_EXTRACT_MODEL=claude-haiku-4-5-20251001   # KAP filing extraction (numbers are validated against the source text)
# INSTILENS_AI_LOCAL_BASE_URL=http://127.0.0.1:11434
# INSTILENS_AI_LOCAL_MODEL=

# ── news ticker + live TV ────────────────────────────────────────────────────────────────────────────
# INSTILENS_NEWS_ENABLED=true                     # RSS headlines (TR first, then global)
# INSTILENS_NEWSAPI_KEY=                          # optional NewsAPI keyword source
# INSTILENS_AI_NEWS_ENABLED=true                  # Claude tags/summaries for headlines (needs ANTHROPIC_API_KEY)
# INSTILENS_AI_NEWS_MODEL=claude-haiku-4-5-20251001   # headline tagging is a cheap pass
# "Name|YOUTUBE_CHANNEL_ID", comma-separated 24/7 streams; replacing this replaces the whole list
# INSTILENS_LIVE_TV_CHANNELS=Ekotürk|UCAGVKxpAKwXMWdmcHbrvcwQ, TRT Haber|UCBgTP2LOFVPmq15W-RH-WXA, Yahoo Finance|UCEAZeUIeJs0IjQiqTCdVSIg, CNBC|UCvJJ_dzjViJCoLf5uKUTwoA, Bloomberg TV|UCdK2BueKxC9VxXh7e1Ne4oQ

# ── text-to-speech for AI notes (optional; ElevenLabs preferred for Turkish, OpenAI as alternative) ──
# INSTILENS_ELEVENLABS_API_KEY=
# INSTILENS_ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku   # fallback voice (Lily) when no language/gender voice is set
# INSTILENS_ELEVENLABS_MODEL=eleven_multilingual_v2    # eleven_v3 (most expressive) · eleven_turbo_v2_5 (fast)
# INSTILENS_ELEVENLABS_SPEED=0.92                 # 0.7–1.2; finance narration reads better slightly under 1.0
# INSTILENS_ELEVENLABS_STABILITY=0.4              # lower = livelier intonation, higher = flatter
# INSTILENS_ELEVENLABS_STYLE=0.55                 # 0 = flat, 1 = very expressive
# INSTILENS_ELEVENLABS_SPEAKER_BOOST=true
# INSTILENS_ELEVENLABS_PARAGRAPH_PAUSE_S=0.9      # pause between paragraphs
# INSTILENS_ELEVENLABS_VOICE_TR_FEMALE=           # per language × gender; empty = VOICE_ID above
# INSTILENS_ELEVENLABS_VOICE_TR_MALE=
# INSTILENS_ELEVENLABS_VOICE_EN_FEMALE=pFZP5JQG7iQjIQuC4Bku
# INSTILENS_ELEVENLABS_VOICE_EN_MALE=pNInz6obpgDQGcFmaJgB
# extra selectable voices (Admin → Ayarlar), "lang:gender:VOICE_ID:Ad"; replacing this replaces the whole list
# INSTILENS_ELEVENLABS_EXTRA_VOICES=tr:female:21m00Tcm4TlvDq8ikWAM:Rachel, tr:male:VR6AewLTigWG4xSOukaG:Arnold, tr:female:EXAVITQu4vr4xnSDxMaL:Bella, tr:male:TxGEqnHWrfWFTfGW9XjX:Josh, en:female:21m00Tcm4TlvDq8ikWAM:Rachel, en:male:VR6AewLTigWG4xSOukaG:Arnold, en:female:EXAVITQu4vr4xnSDxMaL:Bella, en:male:TxGEqnHWrfWFTfGW9XjX:Josh
# INSTILENS_OPENAI_API_KEY=                       # OpenAI TTS instead of ElevenLabs
# INSTILENS_OPENAI_TTS_VOICE=alloy

# ── notifications ────────────────────────────────────────────────────────────────────────────────────
# INSTILENS_TELEGRAM_BOT_TOKEN=                   # @BotFather → /newbot; users paste their chat id in Alarmlar
# INSTILENS_SMTP_HOST=                            # e-mail alerts
# INSTILENS_SMTP_PORT=587
# INSTILENS_SMTP_USER=
# INSTILENS_SMTP_PASSWORD=
# INSTILENS_SMTP_FROM=                            # (example) alerts@instilens.com — REQUIRED for e-mail alerts (unset = e-mail channel off)
# INSTILENS_VAPID_PUBLIC_KEY=                     # Web Push; generate once: instilens vapid-keys (needs HTTPS)
# INSTILENS_VAPID_PRIVATE_KEY=
# INSTILENS_VAPID_SUBJECT=mailto:alerts@instilens.app   # contact shown to the push service
# INSTILENS_ONESIGNAL_APP_ID=                     # optional OneSignal alongside VAPID (app id is public, REST key stays here)
# INSTILENS_ONESIGNAL_REST_API_KEY=

# ── desktop releases (Tauri updater; Admin → Sürüm yönetimi) ────────────────────────────────────────
# INSTILENS_RELEASES_DIR=/opt/instilens/backend/media/releases  # (example) default: backend/media/releases (backed up nightly by backup.sh)
# INSTILENS_RELEASE_UPLOAD_KEY=                   # openssl rand -hex 32 — CI / desktop-release.sh upload with it (x-release-key header)
# INSTILENS_DESKTOP_UPDATER_PUBKEY=               # public half from `tauri signer generate`; safe to publish

# ── ops scripts (read by infra/pm2/backup.sh, not by the app) ───────────────────────────────────────
# INSTILENS_BACKUP_PASSPHRASE=                    # openssl rand -hex 32 — encrypts the nightly .env copy; without it .env is not backed up
# INSTILENS_BACKUP_REMOTE=                        # off-site copy: user@host:/backups (rsync/scp) or r2:bucket/instilens (rclone), 14-day retention both sides
